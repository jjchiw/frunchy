# Copy to deploy/.env and fill in. The file is read by Compose only; keep it out of git (.env is ignored).
# Nothing here is a default you can keep: every "change-me" value is a placeholder that must be replaced by a generated secret.

# --- Always needed -------------------------------------------------------------------------------------------------

# Password of the Postgres user "frunchy" (both databases). It goes into connection strings: use letters and
# digits only.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24

# Host port Frunchy listens on, on 127.0.0.1 only. Put a TLS proxy (Caddy, Traefik, nginx) in front of it.
FRUNCHY_PORT=8080

# Comma-separated IPs or CIDRs of a TLS proxy placed directly in front of Frunchy (no federation profile), whose
# X-Forwarded-For/-Proto/-Host Frunchy should believe. Leave empty when the gateway (federation) is in front.
# A proxy on the Docker host connects from the bridge address, 172.30.0.1.
FRUNCHY_TRUSTED_PROXIES=

# Username of the root operator (manages operators and reviews MyAnimeList matches). Empty means none.
FRUNCHY_ROOT_OPERATOR=

# MyAnimeList API client id (enrichment stays off without it).
FRUNCHY_MAL_CLIENT_ID=

# Sign-in providers: set Enabled to true only with the credentials filled in, or Frunchy refuses to start.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UMBRAL_ENABLED=false
UMBRAL_AUTHORITY=
UMBRAL_CLIENT_ID=
UMBRAL_CLIENT_SECRET=

# --- Federation (optional) -----------------------------------------------------------------------------------------
# To federate, set BOTH of these and every variable below, then start as usual:
#   COMPOSE_PROFILES=federation   starts megafono and the gateway
#   FRUNCHY_FEDERATION_ENABLED=true   tells Frunchy
# Frunchy refuses to start with FRUNCHY_FEDERATION_ENABLED=true and a missing value, naming the setting.
COMPOSE_PROFILES=
FRUNCHY_FEDERATION_ENABLED=false

# Public host name of the deployment, no scheme or path. Actor ids are https://DOMAIN/ap/actors/{id}.
# PERMANENT once you federate: changing it later orphans every follower.
DOMAIN=frunchy.example.com

# Base64 of 32 random bytes. Encrypts every actor's private key. BACK IT UP apart from the database: losing it
# makes every actor unusable.
#   openssl rand -base64 32
MEGAFONO_MASTER_KEY=change-me-generate-with-openssl-rand-base64-32

# Bearer token between Frunchy and Megafono, in both directions.
#   openssl rand -hex 32
MEGAFONO_TOKEN=change-me-generate-with-openssl-rand-hex-32

# Secret that signs the webhooks Megafono sends to Frunchy (Megafono-Signature, HMAC-SHA256).
#   openssl rand -hex 32
MEGAFONO_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# Host port of the gateway, on 127.0.0.1 only: point your TLS proxy at it and send it the whole domain.
GATEWAY_PORT=8090

# The TLS proxy in front of the gateway, as the gateway sees it (the bridge address for a proxy on this host).
GATEWAY_TRUSTED_PROXIES=172.30.0.1

# Megafono and gateway image version (pinned: upgrade deliberately, reading Megafono's release notes first).
MEGAFONO_VERSION=0.1.1

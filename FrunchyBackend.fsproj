<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The nested test project must not be picked up by the Web SDK's default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    <!-- Provider credentials live in `dotnet user-secrets` (outside the repo) or the environment -->
    <UserSecretsId>frunchy-backend</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domains/Identity.fs" />
    <Compile Include="Domains/Catalog.fs" />
    <Compile Include="Domains/Tracking.fs" />
    <Compile Include="Infrastructure/Database.fs" />

    <Compile Include="Infrastructure/SecurityEvents.fs" />
    <Compile Include="Infrastructure/AccountActions.fs" />
    <Compile Include="Infrastructure/WebAuth.fs" />
    <Compile Include="Infrastructure/MalModel.fs" />
    <Compile Include="Infrastructure/JikanModel.fs" />
    <Compile Include="Infrastructure/MalApiModel.fs" />
    <Compile Include="Infrastructure/MalMatching.fs" />
    <Compile Include="Infrastructure/MalCatalog.fs" />
    <Compile Include="Infrastructure/MalClient.fs" />
    <Compile Include="Views/Texts.fs" />
    <Compile Include="Views/Layout.fs" />
    <Compile Include="Handlers/Home.fs" />
    <Compile Include="Handlers/Api/CreateImport.fs" />
    <Compile Include="Handlers/Api/GetImportStatus.fs" />
    <Compile Include="Handlers/Api/WhoAmI.fs" />
    <Compile Include="Handlers/Users/Dashboard.fs" />
    <Compile Include="Handlers/Auth/SignIn.fs" />
    <Compile Include="Handlers/Auth/Complete.fs" />
    <Compile Include="Handlers/Auth/SignUp.fs" />
    <Compile Include="Handlers/Auth/SignOut.fs" />
    <Compile Include="Handlers/Auth/Claim.fs" />
    <Compile Include="Handlers/Auth/Reconfirm.fs" />
    <Compile Include="Handlers/Account/AccountPage.fs" />
    <Compile Include="Handlers/Account/SyncKey.fs" />
    <Compile Include="Handlers/Account/DisplayName.fs" />
    <Compile Include="Handlers/Account/ResetBinding.fs" />
    <Compile Include="Handlers/Account/Logins.fs" />
    <Compile Include="Handlers/Account/DeleteAccount.fs" />
    <Compile Include="Operations/CreateUser.fs" />
    <Compile Include="Operations/RegenerateKey.fs" />
    <Compile Include="Operations/ResetBinding.fs" />
    <Compile Include="Operations/RebuildUser.fs" />
    <Compile Include="Operations/DeleteUser.fs" />

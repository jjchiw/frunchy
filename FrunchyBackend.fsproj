<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The nested test project must not be picked up by the Web SDK's default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domains/Identity.fs" />
    <Compile Include="Domains/Catalog.fs" />
    <Compile Include="Domains/Tracking.fs" />
    <Compile Include="Infrastructure/Database.fs" />
    <Compile Include="Infrastructure/ApiErrors.fs" />
    <Compile Include="Infrastructure/Auth.fs" />
    <Compile Include="Views/Texts.fs" />
    <Compile Include="Views/Layout.fs" />
    <Compile Include="Handlers/Home.fs" />
    <Compile Include="Operations/CreateUser.fs" />
    <Compile Include="Workers/ImportProcessor.fs" />
    <Compile Include="Program.fs" />
    <Folder Include="design\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oxpecker" Version="2.1.1" />
    <PackageReference Include="Oxpecker.ViewEngine" Version="2.1.*" />
    <PackageReference Include="Oxpecker.Htmx" Version="4.0.*" />
    <PackageReference Include="Oxpecker.Alpine" Version="0.3.*" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
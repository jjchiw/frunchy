<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The nested test and AppHost projects must not be picked up by the Web SDK's default globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;AppHost/**</DefaultItemExcludes>
    <!-- Provider credentials live in `dotnet user-secrets` (outside the repo) or the environment -->
    <UserSecretsId>frunchy-backend</UserSecretsId>
  </PropertyGroup>


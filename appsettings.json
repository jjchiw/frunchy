{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=frunchydb"
  },
  "Frunchy": {
    "Auth": {
      "Providers": {
        "Google": {
          "Enabled": false
        },
        "Discord": {
          "Enabled": false
        }
      }
    },
    "EnrichmentWorkerEnabled": true,
    "Jikan": {
      "BaseUrl": "https://api.jikan.moe/v4/",
      "RequestsPerSecond": 1,
      "RetryBaseDelay": "00:00:02",
      "AttemptTimeout": "00:00:15"
    },
    "Enrichment": {
      "PauseAfterFailures": 5,
      "PauseFor": "00:05:00",
      "RefreshAfterDays": 30,
      "RefreshAiringAfterDays": 7
    }
  }
}
